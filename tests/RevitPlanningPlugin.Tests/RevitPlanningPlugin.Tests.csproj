<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>RevitPlanningPlugin.Tests</RootNamespace>
    <!--
      Тестовый проект компилирует исходники напрямую, без зависимости от Revit API DLL.
      Revit-зависимые слои (UI, Revit/*) исключены из компиляции.
    -->
  </PropertyGroup>

  <!-- Прямое включение исходных файлов (без Revit-зависимых) -->
  <ItemGroup>
    <Compile Include="../../src/RevitPlanningPlugin/Models/**/*.cs" />
    <Compile Include="../../src/RevitPlanningPlugin/Services/**/*.cs" />
    <Compile Include="../../src/RevitPlanningPlugin/Infrastructure/**/*.cs" />
    <!-- Исключаем Revit API зависимые файлы -->
    <Compile Remove="../../src/RevitPlanningPlugin/Revit/**/*.cs" />
    <Compile Remove="../../src/RevitPlanningPlugin/UI/**/*.cs" />
    <Compile Remove="../../src/RevitPlanningPlugin/App.cs" />
    <Compile Remove="../../src/RevitPlanningPlugin/Commands/**/*.cs" />
    <Compile Remove="../../src/RevitPlanningPlugin/Properties/**/*.cs" />
    <!-- Исключаем WPF-зависимые инфраструктурные файлы -->
    <Compile Remove="../../src/RevitPlanningPlugin/Infrastructure/MvvmBase.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.2.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageReference Include="IndexRange" Version="1.0.3" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
